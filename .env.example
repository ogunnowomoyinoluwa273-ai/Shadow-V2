BOT_NAME=Shadow
BOT_PREFIX=.
OWNER_NAME=Miyamaru
OWNER_NUMBER=
BOT_VERSION=1.0.0
LOG_LEVEL=info
WELCOME_DEFAULT=Welcome {user} to {group}! You are member {count}.
GOODBYE_DEFAULT=Goodbye {user} from {group}.
PAIRING_NUMBER=
AUTH_DIR=./data/auth
SETTINGS_FILE=./data/group-settings.json
WARNINGS_FILE=./data/warnings.json
SUDO_FILE=./data/sudo.json
MAX_TAGALL=100
BROADCAST_GROUPS=
FFMPEG_PATH=
FFPROBE_PATH=
ANTIDELETE_LOG_JID=
YTDLP_PATH=
DOWNLOADER_TIMEOUT_MS=180000
DOWNLOADER_MAX_BYTES=52428800
DOWNLOADER_CONCURRENCY=1
# Conversation memory
HISTORY_MAX_TURNS=24
HISTORY_PROMPT_TURNS=12
HISTORY_TTL_HOURS=336
CHAT_CONTEXT_TTL_MINUTES=180
# Recognition mark: Shadow reacts to every message he sends (they otherwise look like yours). Empty = off.
BOT_MESSAGE_REACTION=♠️
# Messages older than this (seconds) are treated as history from while Shadow was offline and are not acted on. 0 = off.
MAX_MESSAGE_AGE_SECONDS=300
# "Shadow, tag everyone" style requests run the matching command (same permissions; sensitive actions ask for confirmation). off = disable.
NATURAL_COMMANDS=on
LRCLIB_CLIENT_CONTACT=https://github.com/ogunnowomoyinoluwa273-ai/Shadow-V2
